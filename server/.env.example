# ─── Reiken Server – Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git!

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database (Neon – free PostgreSQL) ────────────────────────────────────────
# Get this from: https://neon.tech → New Project → Connection String
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/reiken?sslmode=require

# ── Vector Store (Turso – free hosted SQLite) ─────────────────────────────────
# Get these from: https://turso.tech → New Database → Get connection string
# Leave blank to use a local SQLite file (file:vectorstore.sqlite) for dev
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQS...

# ── LLM – Groq (free tier, OpenAI-compatible) ────────────────────────────────
# Get this from: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...
LLM_MODEL=llama3-8b-8192

# ── Embeddings – Google Gemini (free tier) ───────────────────────────────────
# Get this from: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=AIza...
EMBED_MODEL=text-embedding-004

# ── Auth ──────────────────────────────────────────────────────────────────────
# Use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-this

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your deployed frontend URL (Vercel). No trailing slash.
CLIENT_URL=https://reiken.vercel.app

# ── RAG Chunking (optional tuning) ───────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
